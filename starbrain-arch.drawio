        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% =========================\n    %% AI Applications\n    %% =========================\n\n    subgraph APP[\&quot;1. AI应用层\&quot;]\n        TC[\&quot;庭策（模拟法庭）\&quot;]\n        FIG[\&quot;手办\&quot;]\n        DOG[\&quot;看家狗\&quot;]\n        OTHER[\&quot;其他应用\&quot;]\n    end\n\n    %% =========================\n    %% Unified Entry\n    %% =========================\n\n    NGINX[\&quot;Nginx 统一入口\&quot;]\n\n    %% =========================\n    %% Hermes\n    %% =========================\n\n    subgraph HERMES[\&quot;2. Hermes Policy Brain（AI控制平面）\&quot;]\n        CLASSIFY[\&quot;任务分类\&quot;]\n        ROUTE[\&quot;能力路由\&quot;]\n        POLICY[\&quot;策略决策\&quot;]\n        WORKFLOW[\&quot;工作流规划\&quot;]\n        TENANT[\&quot;租户策略\&quot;]\n        RESOURCE[\&quot;资源策略\&quot;]\n    end\n\n    %% =========================\n    %% Execution Decision\n    %% =========================\n\n    DECISION{\&quot;执行路径决策\&quot;}\n\n    %% =========================\n    %% Realtime Path\n    %% =========================\n\n    subgraph REALTIME[\&quot;A. 实时推理路径\&quot;]\n        LITELLM[\&quot;LiteLLM Gateway\&quot;]\n\n        subgraph MODEL[\&quot;模型服务（GPUStack）\&quot;]\n            MODEL_MGMT[\&quot;模型管理\&quot;]\n            DEPLOY[\&quot;模型部署\&quot;]\n            ENDPOINT[\&quot;服务端点\&quot;]\n            AUTOSCALE[\&quot;自动伸缩\&quot;]\n        end\n\n        VLLM[\&quot;vLLM / SGLang / TGI\&quot;]\n    end\n\n    %% =========================\n    %% Audio Path\n    %% =========================\n\n    subgraph AUDIO[\&quot;实时语音服务\&quot;]\n        FUNASR[\&quot;FunASR Streaming Service\&quot;]\n    end\n\n    %% =========================\n    %% AI Job Path\n    %% =========================\n\n    subgraph JOB[\&quot;B. AI作业执行路径\&quot;]\n        OPENCLAW[\&quot;OpenClaw\&quot;]\n\n        OPERATOR[\&quot;AIWorkload Operator\&quot;]\n\n        VOLCANO[\&quot;Volcano Scheduler\&quot;]\n    end\n\n    %% =========================\n    %% Infrastructure\n    %% =========================\n\n    subgraph INFRA[\&quot;共享基础设施\&quot;]\n        K8S[\&quot;Kubernetes\&quot;]\n        HAMI[\&quot;HAMi\&quot;]\n        GPU[\&quot;GPU / NPU / CPU\&quot;]\n    end\n\n    %% =========================\n    %% Security\n    %% =========================\n\n    subgraph SECURITY[\&quot;安全治理域\&quot;]\n        SSO[\&quot;SSO / OIDC\&quot;]\n        RBAC[\&quot;RBAC / ABAC\&quot;]\n        QUOTA[\&quot;Quota\&quot;]\n        AUDIT[\&quot;Audit\&quot;]\n    end\n\n    %% =========================\n    %% Observability\n    %% =========================\n\n    subgraph OBS[\&quot;运维与可观测域\&quot;]\n        PROM[\&quot;Prometheus\&quot;]\n        GRAF[\&quot;Grafana\&quot;]\n        OTEL[\&quot;OpenTelemetry\&quot;]\n        TRACE[\&quot;AI Trace\&quot;]\n    end\n\n    %% =========================\n    %% Main Flow\n    %% =========================\n\n    TC --&gt; NGINX\n    FIG --&gt; NGINX\n    DOG --&gt; NGINX\n    OTHER --&gt; NGINX\n\n    NGINX --&gt; HERMES\n\n    HERMES --&gt; DECISION\n\n    %% Realtime\n    DECISION --&gt; LITELLM\n    LITELLM --&gt; MODEL\n    MODEL --&gt; VLLM\n\n    %% Audio\n    DECISION --&gt; FUNASR\n\n    %% Job\n    DECISION --&gt; OPENCLAW\n    OPENCLAW --&gt; OPERATOR\n    OPERATOR --&gt; VOLCANO\n\n    %% Infra\n    VLLM --&gt; K8S\n    FUNASR --&gt; K8S\n    VOLCANO --&gt; K8S\n\n    K8S --&gt; HAMI\n    HAMI --&gt; GPU\n\n    %% Governance\n    SECURITY -.-&gt; HERMES\n    SECURITY -.-&gt; OPENCLAW\n    SECURITY -.-&gt; K8S\n\n    %% Observability\n    OBS -.-&gt; HERMES\n    OBS -.-&gt; LITELLM\n    OBS -.-&gt; OPENCLAW\n    OBS -.-&gt; K8S&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Z3bSTiDJOYV1SwZ_F95R-1">
